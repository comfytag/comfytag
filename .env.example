# Database (external, e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/comfytag?retryWrites=true&w=majority

# Auth
JWT_SECRET=your-jwt-secret-here

# Email (ZeptoMail — primary, via Nodemailer SMTP)
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=emailapikey
ZEPTOMAIL_SMTP_TOKEN=your-zeptomail-send-mail-token

# Email (Resend — fallback, used only if ZeptoMail send fails)
RESEND_API_KEY=your-resend-api-key

# Email sender addresses (provider-agnostic, used by both ZeptoMail and Resend)
EMAIL_SENDER_DEFAULT=noreply@comfytag.com
EMAIL_SENDER_TICKETS=tickets@comfytag.com
EMAIL_SENDER_EVENTS=events@comfytag.com
EMAIL_SENDER_PAYOUTS=payouts@comfytag.com
EMAIL_SENDER_SUPPORT=support@comfytag.com
EMAIL_SENDER_HELLO=hello@comfytag.com
EMAIL_SENDER_PARTNER=partner@comfytag.com

# SMS (Termii)
TERMII_API_KEY=your-termii-key
TERMII_SENDER_ID=ComfyTag

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# KBY-AI Face SDK
KBYAI_LICENSE_KEY=your-license-key

# Admin alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
YCLOUD_API_KEY=your-ycloud-key

# Next.js apps
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:3000
