# Database
MONGODB_URI=mongodb://localhost:27017/comfytag

# Auth
JWT_SECRET=your-jwt-secret-here

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# SMS (Termii)
TERMII_API_KEY=your-termii-key
TERMII_SENDER_ID=ComfyTag

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# KBY-AI Face SDK
KBYAI_LICENSE_KEY=your-license-key

# Admin alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
YCLOUD_API_KEY=your-ycloud-key

# Next.js apps
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker / MongoDB local
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme
