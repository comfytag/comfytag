# ========== CORE (REQUIRED IN ALL ENVIRONMENTS) ==========
PORT=4002
JWT_SECRET=your-secret-key-here
NODE_ENV=development

# ========== DATABASE & CACHE ==========
# MongoDB Connection URI (external, e.g. MongoDB Atlas)
MONGO=mongodb+srv://user:pass@cluster.mongodb.net/comfytag?retryWrites=true&w=majority

# Redis Connection (for email queue, background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ========== WEB URLS (Development) ==========
WEB_URL=http://localhost:3000
PARTNER_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# ========== EMAIL (AWS SES) — REQUIRED FOR PRODUCTION ==========
# Create an IAM user with AmazonSESFullAccess (or a scoped SES policy) and
# paste its credentials below. Never commit real keys.
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_REGION=us-east-1

# The verified SES sender address (must be verified in AWS SES console)
SES_SENDER_EMAIL=noreply@comfytag.com

# Legacy Resend keys — kept for reference during transition; remove after cut-over
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_DEFAULT=noreply@comfytag.com
# RESEND_FROM_TICKETS=tickets@comfytag.com

# ========== UPLOADS (Cloudinary) ==========
# Get credentials from: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========== PAYMENTS (Paystack) ==========
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
