# ========== CORE (REQUIRED IN ALL ENVIRONMENTS) ==========
PORT=4002
JWT_SECRET=your-secret-key-here
NODE_ENV=development

# ========== DATABASE & CACHE ==========
# MongoDB Connection URI
MONGO=mongodb://admin:changeme@localhost:27018/comfytag?authSource=admin

# Redis Connection (for email queue, background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ========== WEB URLS (Development) ==========
WEB_URL=http://localhost:3000
PARTNER_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# ========== EMAIL (Resend SMTP) — REQUIRED FOR PRODUCTION ==========
# Get your Resend API key from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxx (live key) or test-key-development (dev only)
RESEND_API_KEY=re_5cEckmSS_N6ge4VonTJtXTF3gJQSJaC6X

# Sender email addresses (customize if needed)
RESEND_FROM_DEFAULT=noreply@comfytag.com
RESEND_FROM_TICKETS=tickets@comfytag.com

# ========== UPLOADS (Cloudinary) ==========
# Get credentials from: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========== PAYMENTS (Paystack) ==========
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
