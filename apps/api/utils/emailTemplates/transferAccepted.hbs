<h1>Transfer accepted! 🎉</h1>

<p>Hi {{senderName}},</p>

<p>Great news! <strong>{{recipientName}}</strong> just accepted your ticket to <strong>{{eventName}}</strong>. You're all set!</p>

<div style="background-color: #f0fdf4; border-left: 4px solid #10b981; padding: 16px; margin: 24px 0; border-radius: 4px;">
  <p style="margin: 0; color: #065f46;"><strong>✓ Transfer complete</strong></p>
  <p style="margin: 8px 0 0 0; font-size: 14px; color: #078945;">Your friend has the ticket and can enroll their face to check in at the venue.</p>
</div>

<div style="background-color: #fafaf9; border: 1px solid #e7e5e4; border-radius: 8px; padding: 16px; margin: 24px 0;">
  <h3 style="margin-top: 0; font-size: 16px;">Event Reminder</h3>
  <p><strong>{{eventName}}</strong></p>
  <p style="margin-bottom: 8px;">📅 {{eventDate}}</p>
  <p style="margin: 0; font-size: 14px; color: #78716c;">🎫 {{ticketTier}} Tier</p>
</div>

{{> ctaButton text="View My Tickets" url=dashboardLink }}

<p style="color: #a8a29e; font-size: 14px; margin-top: 32px;">Thank you for using ComfyTag!</p>
