<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{heading}} — ComfyTag</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F5F3FF; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color: #F5F3FF; padding: 24px 16px;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width: 480px; background-color: #FFFFFF; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 32px rgba(124, 58, 237, 0.12);">

          <!-- HEADER -->
          <tr>
            <td style="background: linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%); padding: 28px 32px 24px; text-align: center;">
              <p style="margin: 0 0 4px; font-size: 24px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.5px; line-height: 1;">ComfyTag</p>
              <p style="margin: 0; font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.65); letter-spacing: 2px; text-transform: uppercase;">Your face is your ticket</p>
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding: 36px 32px 0;">

              <h1 style="margin: 0 0 12px; font-size: 24px; font-weight: 800; color: #1C1917; line-height: 1.2; letter-spacing: -0.3px;">{{heading}}</h1>
              <p style="margin: 0 0 28px; font-size: 15px; color: #78716C; line-height: 1.65;">{{intro}}</p>

              <!-- OTP CODE BOX -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 24px;">
                <tr>
                  <td style="background-color: #FAFAF9; border: 2px solid #EDE9FE; border-radius: 16px; padding: 32px 24px; text-align: center;">
                    <p style="margin: 0 0 20px; font-size: 11px; font-weight: 700; color: #A8A29E; letter-spacing: 2px; text-transform: uppercase;">{{codeLabel}}</p>
                    <p style="margin: 0 0 20px; font-size: 44px; font-weight: 800; color: #7C3AED; letter-spacing: 12px; font-family: 'Courier New', 'Lucida Console', monospace; line-height: 1;">{{otp}}</p>
                    <!-- Expiry -->
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin: 0 auto;">
                      <tr>
                        <td style="background-color: #FFFBEB; border: 1px solid #FDE68A; border-radius: 20px; padding: 5px 14px;">
                          <p style="margin: 0; font-size: 12px; font-weight: 600; color: #92400E;">⏱ Expires in {{expiryText}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- SECURITY NOTICE -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 32px;">
                <tr>
                  <td style="background-color: #F5F5F4; border-radius: 10px; padding: 16px 18px;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td width="24" valign="top" style="padding-top: 1px; font-size: 15px; line-height: 1;">🔒</td>
                        <td style="padding-left: 8px;">
                          <p style="margin: 0 0 2px; font-size: 13px; font-weight: 700; color: #1C1917;">Security Notice</p>
                          <p style="margin: 0; font-size: 13px; color: #78716C; line-height: 1.55;">{{securityNotice}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background-color: #F5F5F4; border-top: 1px solid #E7E5E4; padding: 20px 32px; text-align: center;">
              <p style="margin: 0 0 6px; font-size: 12px; color: #A8A29E; line-height: 1.5;">© {{year}} ComfyTag. All rights reserved.</p>
              <p style="margin: 0; font-size: 12px; line-height: 1.5;">
                <a href="{{unsubscribeUrl}}" style="color: #A8A29E; text-decoration: none;">Unsubscribe</a>
                <span style="margin: 0 8px; color: #D6D3D1;">·</span>
                <a href="{{preferencesUrl}}" style="color: #A8A29E; text-decoration: none;">Email Preferences</a>
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
