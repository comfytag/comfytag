<blockquote style="background-color: #f5f5f4; border-left: 4px solid #7c3aed; border-radius: 8px; padding: 16px; margin: 16px 0; font-style: italic; color: #78716c;">
  <p style="margin: 0; font-size: 16px;">"{{quote}}"</p>
  <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e7e5e4;">
    <p style="margin: 0; color: #1c1917; font-weight: 600; font-style: normal; font-size: 14px;">{{author}}</p>
    {{#if role}}<p style="margin: 4px 0 0 0; color: #78716c; font-size: 12px; font-style: normal;">{{role}}</p>{{/if}}
  </div>
</blockquote>
