<div style="background-color: #f5f5f4; border: 1px solid #e7e5e4; border-radius: 12px; padding: 16px; margin: 16px 0;">
  {{#if image}}
  <img src="{{image}}" alt="{{title}}" style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px; margin-bottom: 12px; display: block;" />
  {{/if}}
  <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #1c1917;">{{title}}</h3>
  {{#if description}}
  <p style="color: #78716c; font-size: 14px; margin-bottom: 12px;">{{description}}</p>
  {{/if}}
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding-top: 12px; border-top: 1px solid #e7e5e4;">
    <tr>
      {{#if date}}<td style="color: #78716c; font-size: 12px; font-weight: 500;">📅 {{date}}</td>{{/if}}
      {{#if badge}}<td align="right"><span style="background-color: #ede9fe; color: #7c3aed; padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600;">{{badge}}</span></td>{{/if}}
    </tr>
  </table>
</div>
