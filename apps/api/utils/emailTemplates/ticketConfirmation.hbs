<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ComfyTag Ticket — {{eventName}}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F5F3FF; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color: #F5F3FF; padding: 24px 16px;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width: 560px; background-color: #FFFFFF; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 32px rgba(124, 58, 237, 0.12);">

          <!-- HEADER -->
          <tr>
            <td style="background: linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%); padding: 28px 32px 24px; text-align: center;">
              <p style="margin: 0 0 4px; font-size: 24px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.5px; line-height: 1;">ComfyTag</p>
              <p style="margin: 0; font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.65); letter-spacing: 2px; text-transform: uppercase;">Your face is your ticket</p>
            </td>
          </tr>

          <!-- HERO -->
          <tr>
            <td style="padding: 32px 32px 24px; text-align: center; border-bottom: 1px solid #F3F0FF;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td align="center" style="padding-bottom: 16px;">
                    <span style="display: inline-block; background-color: #EDE9FE; color: #7C3AED; font-size: 11px; font-weight: 700; padding: 5px 14px; border-radius: 20px; letter-spacing: 0.8px; text-transform: uppercase;">Ticket Confirmed ✓</span>
                  </td>
                </tr>
                <tr>
                  <td>
                    <p style="margin: 0 0 10px; font-size: 28px; font-weight: 800; color: #1C1917; line-height: 1.15; letter-spacing: -0.5px;">ComfyTag Ticket</p>
                    <p style="margin: 0; font-size: 17px; font-weight: 600; color: #7C3AED; line-height: 1.5;">{{eventName}}</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding: 28px 32px 0;">

              <!-- GREETING -->
              {{#if attendeeName}}
              <p style="margin: 0 0 6px; font-size: 16px; font-weight: 700; color: #1C1917;">Hi {{attendeeName}},</p>
              {{else}}
              <p style="margin: 0 0 6px; font-size: 16px; font-weight: 700; color: #1C1917;">Hi there,</p>
              {{/if}}
              <p style="margin: 0 0 28px; font-size: 15px; color: #78716C; line-height: 1.65;">Your ticket for <strong style="color: #1C1917; font-weight: 600;">{{eventName}}</strong> is confirmed. Keep this email — you'll scan the QR code below to get in.</p>

              {{!-- QR CODE --}}
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 24px;">
                <tr>
                  <td style="background-color: #FAFAF9; border: 2px dashed #C4B5FD; border-radius: 16px; padding: 28px 20px; text-align: center;">
                    <p style="margin: 0 0 16px; font-size: 11px; font-weight: 700; color: #7C3AED; letter-spacing: 1.5px; text-transform: uppercase;">Scan at the Gate</p>
                    <img src="{{qrCodeUrl}}" alt="Your QR Code" width="200" height="200" style="display: block; margin: 0 auto; border-radius: 10px; border: 4px solid #FFFFFF; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">
                    <p style="margin: 16px 0 0; font-size: 14px; color: #78716C; line-height: 1;">
                      <strong style="color: #1C1917; font-weight: 700;">{{qty}}×</strong> {{ticketTier}} {{ticketLabel}}
                    </p>
                  </td>
                </tr>
              </table>

              {{!-- EVENT DETAILS --}}
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 20px; border-radius: 14px; overflow: hidden; border: 1.5px solid #EDE9FE;">
                <tr>
                  <td style="background-color: #EDE9FE; padding: 11px 20px; border-bottom: 1px solid #DDD6FE;">
                    <p style="margin: 0; font-size: 11px; font-weight: 700; color: #7C3AED; letter-spacing: 1px; text-transform: uppercase;">Event Details</p>
                  </td>
                </tr>
                <tr>
                  <td style="padding: 20px; background-color: #FFFFFF;">

                    <p style="margin: 0 0 16px; font-size: 17px; font-weight: 700; color: #1C1917; line-height: 1.3;">{{eventName}}</p>

                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 10px;">
                      <tr>
                        <td width="24" valign="middle" style="font-size: 15px; line-height: 1;">📅</td>
                        <td style="padding-left: 8px; font-size: 14px; color: #1C1917; font-weight: 500; line-height: 1.4;">{{eventDate}}</td>
                      </tr>
                    </table>

                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 10px;">
                      <tr>
                        <td width="24" valign="middle" style="font-size: 15px; line-height: 1;">🕐</td>
                        <td style="padding-left: 8px; font-size: 14px; color: #1C1917; font-weight: 500; line-height: 1.4;">{{eventTime}}</td>
                      </tr>
                    </table>

                    {{#if eventVenue}}
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 10px;">
                      <tr>
                        <td width="24" valign="middle" style="font-size: 15px; line-height: 1;">📍</td>
                        <td style="padding-left: 8px; font-size: 14px; color: #1C1917; font-weight: 500; line-height: 1.4;">{{eventVenue}}</td>
                      </tr>
                    </table>
                    {{/if}}

                    {{#if organizerName}}
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 10px;">
                      <tr>
                        <td width="24" valign="middle" style="font-size: 15px; line-height: 1;">🎤</td>
                        <td style="padding-left: 8px; font-size: 14px; color: #78716C; line-height: 1.4;">Organized by <strong style="color: #1C1917; font-weight: 600;">{{organizerName}}</strong></td>
                      </tr>
                    </table>
                    {{/if}}

                    {{#if eventDescription}}
                    <p style="margin: 14px 0 0; padding-top: 14px; border-top: 1px solid #F3F0FF; font-size: 13px; color: #78716C; line-height: 1.65;">{{eventDescription}}</p>
                    {{/if}}

                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-top: 18px; padding-top: 16px; border-top: 1.5px solid #E7E5E4;">
                      <tr>
                        <td style="font-size: 13px; color: #78716C; font-weight: 500;">Total Paid</td>
                        <td align="right" style="font-size: 20px; font-weight: 800; color: #7C3AED; line-height: 1;">{{totalPrice}}</td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              {{!-- FACE CHECK-IN COMING SOON --}}
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 20px;">
                <tr>
                  <td style="background: linear-gradient(135deg, #EDE9FE 0%, #F5F3FF 100%); border-left: 4px solid #7C3AED; border-radius: 0 10px 10px 0; padding: 14px 18px;">
                    <p style="margin: 0 0 3px; font-size: 13px; font-weight: 700; color: #7C3AED;">⚡ Face Check-In — Coming Soon</p>
                    <p style="margin: 0; font-size: 13px; color: #6D28D9; line-height: 1.55;">Skip the queue entirely — your face is your ticket. No QR, no hassle. Launching soon on the ComfyTag app.</p>
                  </td>
                </tr>
              </table>

              {{!-- SHARE & EARN --}}
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 28px;">
                <tr>
                  <td style="background-color: #FAFAF9; border: 1.5px solid #E7E5E4; border-radius: 12px; padding: 20px; text-align: center;">
                    <p style="margin: 0 0 4px; font-size: 15px; font-weight: 700; color: #1C1917;">Share &amp; Earn</p>
                    <p style="margin: 0 0 18px; font-size: 13px; color: #78716C; line-height: 1.6;">Know someone who should be at <strong style="color: #1C1917;">{{eventName}}</strong>? Share and earn rewards when they grab a ticket.</p>
                    <a href="{{shareLink}}" style="display: inline-block; background-color: #7C3AED; color: #FFFFFF; padding: 13px 32px; border-radius: 9px; text-decoration: none; font-weight: 700; font-size: 14px; letter-spacing: 0.2px;">Share This Event</a>
                  </td>
                </tr>
              </table>

              <!-- SIGN OFF -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 28px;">
                <tr>
                  <td style="text-align: center;">
                    <p style="margin: 0 0 6px; font-size: 22px; line-height: 1;">🎉</p>
                    <p style="margin: 0 0 6px; font-size: 15px; font-weight: 600; color: #1C1917;">See you at the gate!</p>
                    <p style="margin: 0; font-size: 13px; color: #A8A29E; line-height: 1.5;">Questions? <a href="https://comfytag.com/support/faq" style="color: #7C3AED; text-decoration: none; font-weight: 500;">Check our FAQ</a> or reply to this email anytime.</p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background-color: #F5F5F4; border-top: 1px solid #E7E5E4; padding: 20px 32px; text-align: center;">
              <p style="margin: 0 0 6px; font-size: 12px; color: #A8A29E; line-height: 1.5;">© {{year}} ComfyTag. All rights reserved.</p>
              <p style="margin: 0; font-size: 12px; line-height: 1.5;">
                <a href="{{unsubscribeUrl}}" style="color: #A8A29E; text-decoration: none;">Unsubscribe</a>
                <span style="margin: 0 8px; color: #D6D3D1;">·</span>
                <a href="{{preferencesUrl}}" style="color: #A8A29E; text-decoration: none;">Email Preferences</a>
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
